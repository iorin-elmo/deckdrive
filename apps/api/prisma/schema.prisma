generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SeasonStatus {
  ACTIVE
  CLOSED
}

enum RatingOutcome {
  WIN
  LOSS
  DRAW
}

enum AbuseReviewStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum Currency {
  GEM
  EXCHANGE_POINT
}

enum PackProduct {
  NORMAL_PACK
  RARE_PACK
  BOX
  WEEKLY_BOX
  MONTHLY_BUNDLE
}

enum MissionCadence {
  DAILY
  WEEKLY
}

enum MissionMetric {
  CPU_BATTLE
  PVP_BATTLE
  CARD_PLAY
  DAMAGE
  BLOCK
  WIN
  RANKED_BATTLE
  CLASS_USAGE
  DECK_OBJECTIVE
}

enum OAuthProvider {
  DISCORD
}

enum CosmeticKind {
  CARD_FRAME
  CARD_FULL_ART_FX
  CARD_ANIMATION
  HOLOGRAM
  LEADER_SKIN
  PLAYMAT
  CARD_SLEEVE
  TITLE
  PROFILE_DECORATION
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  // OAuth identities are the account key; a provider may not supply a usable email address.
  email       String?  @unique @db.Citext
  displayName String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  player      Player?
  oauthAccounts OAuthAccount[]
  sessions      Session[]
  oauthAuthorizations OAuthAuthorization[] @relation("OAuthAuthorizationLinkUser")
  adminActions AdminAction[]
  debugBattles DebugBattle[]

  @@map("users")
}

model AdminAction {
  id          String       @id @default(uuid()) @db.Uuid
  adminUserId String       @map("admin_user_id") @db.Uuid
  requestId   String       @map("request_id") @db.VarChar(100)
  action      String       @db.VarChar(80)
  target      String       @db.VarChar(200)
  reason      String       @db.VarChar(2000)
  payloadHash String       @map("payload_hash") @db.VarChar(64)
  before      Json
  after       Json
  timestamp   DateTime     @default(now()) @db.Timestamptz(6)
  admin       User         @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@unique([adminUserId, requestId])
  @@index([target, timestamp])
  @@index([timestamp])
  @@map("admin_actions")
}

model FeatureFlag {
  name      String   @id @db.VarChar(80)
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model DebugBattle {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  initialState Json     @map("initial_state")
  state        Json
  commands     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  admin        User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("debug_battles")
}

model OAuthAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  authProvider  OAuthProvider? @map("auth_provider")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model OAuthAuthorization {
  id               String        @id @default(uuid()) @db.Uuid
  provider         OAuthProvider
  stateHash        String        @unique @map("state_hash")
  codeVerifierHash String        @map("code_verifier_hash")
  linkUserId       String?       @map("link_user_id") @db.Uuid
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  linkUser         User?         @relation("OAuthAuthorizationLinkUser", fields: [linkUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model Player {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @unique @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  experience Int          @default(0)
  level      Int          @default(1)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cards     PlayerCard[]
  decks     Deck[]
  matches   MatchPlayer[]
  currencyTransactions CurrencyTransaction[]
  packOpenings         PackOpening[]
  missions             PlayerMission[]
  loginRewardClaims    LoginRewardClaim[]
  cosmetics            PlayerCosmetic[]
  cosmeticGrants       CosmeticGrant[]
  experienceTransactions ExperienceTransaction[]
  seasonRatings PlayerSeasonRating[]
  rankedSnapshots RankedMatchPlayer[]
  ratingHistory RatingHistory[]
  ratingAbuseFlags RatingAbuseFlag[]
  rankedQueueEntries RankedQueueEntry[]
  rankedEnqueueRateLimit RankedEnqueueRateLimit?

  @@map("players")
}

model Mission {
  id             String         @id
  cadence        MissionCadence
  metric         MissionMetric
  target         Int
  rewardCurrency Currency       @map("reward_currency")
  rewardAmount   Int            @map("reward_amount")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  playerMissions PlayerMission[]

  @@map("missions")
}

model PlayerMission {
  id          String   @id @default(uuid()) @db.Uuid
  playerId    String   @map("player_id") @db.Uuid
  missionId   String   @map("mission_id")
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  progress    Int      @default(0)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([playerId, missionId, periodStart])
  @@index([playerId, periodStart])
  @@map("player_missions")
}

model LoginRewardClaim {
  id          String   @id @default(uuid()) @db.Uuid
  playerId    String   @map("player_id") @db.Uuid
  day         DateTime @db.Date
  cycleDay    Int      @map("cycle_day")
  reward      Json
  claimedAt   DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, day])
  @@index([playerId, claimedAt])
  @@map("login_reward_claims")
}

model Cosmetic {
  id          String       @id
  kind        CosmeticKind
  name        String
  description String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  owners      PlayerCosmetic[]
  grants      CosmeticGrant[]

  @@map("cosmetics")
}

model PlayerCosmetic {
  id             String   @id @default(uuid()) @db.Uuid
  playerId       String   @map("player_id") @db.Uuid
  cosmeticId     String   @map("cosmetic_id")
  source         String   @default("UNSPECIFIED")
  idempotencyKey String   @map("idempotency_key")
  acquiredAt     DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  cosmetic       Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)

  @@unique([playerId, cosmeticId])
  @@unique([playerId, idempotencyKey])
  @@index([playerId, acquiredAt])
  @@map("player_cosmetics")
}

model CosmeticGrant {
  id             String   @id @default(uuid()) @db.Uuid
  playerId       String   @map("player_id") @db.Uuid
  cosmeticId     String   @map("cosmetic_id")
  source         String
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  cosmetic       Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)

  @@unique([playerId, idempotencyKey])
  @@index([playerId, createdAt])
  @@map("cosmetic_grants")
}

model ExperienceTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  playerId       String   @map("player_id") @db.Uuid
  amount         Int
  reason         String
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, idempotencyKey])
  @@index([playerId, createdAt])
  @@map("experience_transactions")
}

model CurrencyTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  playerId       String   @map("player_id") @db.Uuid
  currency       Currency
  amount         Int
  reason         String
  referenceId    String?  @map("reference_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, idempotencyKey])
  @@index([playerId, createdAt])
  @@map("currency_transactions")
}

model PackOpening {
  id             String      @id @default(uuid()) @db.Uuid
  playerId       String      @map("player_id") @db.Uuid
  product        PackProduct
  gemCost        Int         @map("gem_cost")
  seed           String
  result         Json
  idempotencyKey String      @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  player         Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, idempotencyKey])
  @@index([playerId, createdAt])
  @@map("pack_openings")
}

model Card {
  id        String        @id
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  versions  CardVersion[]

  @@map("cards")
}

model CardVersion {
  id          String       @id @default(uuid()) @db.Uuid
  cardId      String       @map("card_id")
  version     String
  definition  Json
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  card        Card         @relation(fields: [cardId], references: [id], onDelete: Restrict)
  playerCards PlayerCard[]
  deckCards   DeckCard[]

  @@unique([cardId, version])
  @@map("card_versions")
}

model PlayerCard {
  id            String      @id @default(uuid()) @db.Uuid
  playerId      String      @map("player_id") @db.Uuid
  cardVersionId String      @map("card_version_id") @db.Uuid
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  cardVersion   CardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)

  @@unique([playerId, cardVersionId])
  @@index([playerId])
  @@map("player_cards")
}

model Deck {
  id              String     @id @default(uuid()) @db.Uuid
  playerId        String     @map("player_id") @db.Uuid
  name            String
  cardDataVersion String     @map("card_data_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  player          Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  cards           DeckCard[]

  @@unique([playerId, name])
  @@index([playerId, updatedAt])
  @@map("decks")
}

model DeckCard {
  id            String      @id @default(uuid()) @db.Uuid
  deckId        String      @map("deck_id") @db.Uuid
  cardVersionId String      @map("card_version_id") @db.Uuid
  position      Int
  quantity      Int         @default(1)
  deck          Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardVersion   CardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)

  @@unique([deckId, cardVersionId])
  @@unique([deckId, position])
  @@map("deck_cards")
}

model Match {
  id              String          @id
  status          MatchStatus     @default(IN_PROGRESS)
  engineVersion   String          @map("engine_version")
  rulesVersion    String          @map("rules_version")
  cardDataVersion String          @map("card_data_version")
  formatVersion   Int             @default(1) @map("format_version")
  battleProtocolVersion Int?       @map("battle_protocol_version")
  draftDefinitionRevision String?  @map("draft_definition_revision")
  snapshotInterval Int             @default(1) @map("snapshot_interval")
  seed            String
  initialState    Json            @map("initial_state")
  finalState      Json?           @map("final_state")
  checksum        String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  mode            MatchMode?
  queueId         String?         @unique @map("queue_id")
  inviteCode      String?         @unique @map("invite_code")
  players         MatchPlayer[]
  actions         MatchAction[]
  serverCommands  MatchServerCommand[]
  events          MatchEvent[]
  snapshots       MatchSnapshot[]
  draftDefinitionSnapshot ReplayDefinitionSnapshot? @relation(fields: [draftDefinitionRevision], references: [revision], onDelete: Restrict)
  rankedMatch     RankedMatch?
  ratingHistory   RatingHistory[]
  ratingAbuseFlags RatingAbuseFlag[]
  rankedQueueEntries RankedQueueEntry[]

  @@index([status, createdAt])
  @@index([cardDataVersion, rulesVersion, engineVersion])
  @@map("matches")
}

model ReplayDefinitionSnapshot {
  revision    String   @id
  definitions Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  matches     Match[]

  @@map("replay_definition_snapshots")
}

// Pre-alpha battles use the complete card pool and persist every authoritative input.
model AlphaBattle {
  id         String   @id @default(uuid()) @db.Uuid
  hostId     String   @map("host_id") @db.Uuid
  guestId    String?  @map("guest_id") @db.Uuid
  mode       String
  inviteCode String?  @unique @map("invite_code")
  status     String   @default("WAITING")
  decks      Json
  definitions Json
  initialState Json? @map("initial_state")
  state      Json?
  inputs     Json     @default("[]")
  receipts   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, mode, createdAt])
  @@index([hostId, createdAt])
  @@map("alpha_battles")
}

model MatchPlayer {
  id           String @id @default(uuid()) @db.Uuid
  matchId      String @map("match_id")
  playerId     String @map("player_id") @db.Uuid
  seat         Int
  deckSnapshot Json   @map("deck_snapshot")
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(6)
  connectedOnce Boolean @default(false) @map("connected_once")
  disconnectCount Int @default(0) @map("disconnect_count")
  match        Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player       Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  rankedSnapshot RankedMatchPlayer?

  @@unique([matchId, playerId])
  @@unique([matchId, seat])
  @@index([playerId])
  @@map("match_players")
}

model MatchAction {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id")
  sequence  Int
  source    MatchActionSource @default(CLIENT)
  playerId  String?  @map("player_id") @db.Uuid
  requestId String?  @map("request_id")
  action    Json
  response  Json?
  timeoutStreak Int? @map("timeout_streak")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@unique([matchId, playerId, requestId, source])
  @@index([matchId, createdAt])
  @@map("match_actions")
}

enum MatchActionSource {
  CLIENT
  TIMEOUT
  FORFEIT
}

enum MatchMode {
  CASUAL
  PRIVATE
  RANKED
}

enum RankedQueueStatus {
  WAITING
  MATCHED
  EXPIRED
  CANCELLED
}

model RankedQueueEntry {
  id              String            @id @db.Uuid
  playerId        String            @map("player_id") @db.Uuid
  seasonId        String            @map("season_id") @db.Uuid
  deckId          String            @map("deck_id") @db.Uuid
  deckData        Json              @map("deck_data")
  cardDataVersion String            @map("card_data_version")
  rating          Float
  status          RankedQueueStatus @default(WAITING)
  matchId         String?           @map("match_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime          @map("expires_at") @db.Timestamptz(6)
  player          Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  season          Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  match           Match?            @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([status, seasonId, cardDataVersion, createdAt])
  @@index([playerId, createdAt])
  @@index([matchId])
  @@map("ranked_queue_entries")
}

model RankedEnqueueRateLimit {
  playerId    String     @id @map("player_id") @db.Uuid
  attemptedAt DateTime[] @map("attempted_at") @db.Timestamptz(6)
  player      Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@map("ranked_enqueue_rate_limits")
}

model Season {
  id                  String       @id @db.Uuid
  status              SeasonStatus
  startsAt            DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime     @map("ends_at") @db.Timestamptz(6)
  initialRating       Float        @map("initial_rating")
  resetRetention      Float        @map("reset_retention")
  ratingConfigVersion String       @map("rating_config_version")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  ratings             PlayerSeasonRating[]
  rankedMatches       RankedMatch[]
  ratingHistory       RatingHistory[]
  rankedQueueEntries  RankedQueueEntry[]

  @@index([status, startsAt])
  @@map("seasons")
}

model PlayerSeasonRating {
  seasonId       String   @map("season_id") @db.Uuid
  playerId       String   @map("player_id") @db.Uuid
  rating         Float
  completedGames Int      @default(0) @map("completed_games")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([seasonId, playerId])
  @@index([playerId, seasonId])
  @@map("player_season_ratings")
}

model RankedMatch {
  matchId             String   @id @map("match_id")
  seasonId            String   @map("season_id") @db.Uuid
  ratingConfigVersion String   @map("rating_config_version")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  season              Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  players             RankedMatchPlayer[]

  @@index([seasonId, createdAt])
  @@map("ranked_matches")
}

model RankedMatchPlayer {
  matchId              String      @map("match_id")
  playerId             String      @map("player_id") @db.Uuid
  seat                 Int
  ratingAtStart        Float       @map("rating_at_start")
  completedGamesAtStart Int        @map("completed_games_at_start")
  rankedMatch          RankedMatch @relation(fields: [matchId], references: [matchId], onDelete: Restrict)
  player               Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  matchPlayer           MatchPlayer @relation(fields: [matchId, playerId], references: [matchId, playerId], onDelete: Restrict)

  @@id([matchId, playerId])
  @@unique([matchId, seat])
  @@index([playerId, matchId])
  @@map("ranked_match_players")
}

model RatingHistory {
  id                   String        @id @default(uuid()) @db.Uuid
  matchId              String        @map("match_id")
  seasonId             String        @map("season_id") @db.Uuid
  playerId             String        @map("player_id") @db.Uuid
  opponentId           String        @map("opponent_id") @db.Uuid
  outcome              RatingOutcome
  ratingBefore         Float         @map("rating_before")
  ratingAfter          Float         @map("rating_after")
  ratingAtStart        Float         @map("rating_at_start")
  opponentRatingAtStart Float        @map("opponent_rating_at_start")
  delta                Float
  k                    Float
  expectedScore        Float         @map("expected_score")
  actualScore          Float         @map("actual_score")
  damageRatio          Float         @map("damage_ratio")
  damageDealt          Float         @map("damage_dealt")
  opponentInitialHp    Float         @map("opponent_initial_hp")
  ratingConfigVersion  String        @map("rating_config_version")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  match                Match         @relation(fields: [matchId], references: [id], onDelete: Restrict)
  season               Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  player               Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchId, playerId])
  @@index([playerId, seasonId, createdAt])
  @@map("rating_history")
}

model RatingAbuseFlag {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id")
  playerId  String   @map("player_id") @db.Uuid
  type      String
  evidence  Json
  status    AbuseReviewStatus @default(OPEN)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  reviews   RatingAbuseReview[]

  @@unique([matchId, playerId, type])
  @@index([playerId, createdAt])
  @@map("rating_abuse_flags")
}

model RatingAbuseReview {
  id            String @id @default(uuid()) @db.Uuid
  flagId        String @map("flag_id") @db.Uuid
  requestId     String @map("request_id")
  operatorId    String @map("operator_id")
  previousStatus AbuseReviewStatus @map("previous_status")
  nextStatus    AbuseReviewStatus @map("next_status")
  note          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  flag          RatingAbuseFlag @relation(fields: [flagId], references: [id], onDelete: Restrict)

  @@unique([flagId, requestId])
  @@index([flagId, createdAt])
  @@map("rating_abuse_reviews")
}

