# Copy to ~/deckdrive-prod/backup.env on the Pi. This is sourced by bash; quote values.
# The encrypted restic repository must be outside the Raspberry Pi.
RESTIC_REPOSITORY='sftp:backup-user@backup.example.com:/srv/deckdrive'
RESTIC_PASSWORD='replace-with-long-random-restic-password'
# For S3-compatible storage, use RESTIC_REPOSITORY='s3:https://endpoint/bucket'
# and set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.

