# Copy to ~/deckdrive-prod/runtime.env on the Pi. Use mode 0600.
# Do not commit live values. Percent-encode reserved characters in DATABASE_URL.
POSTGRES_USER=deckdrive
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=deckdrive
DATABASE_URL=postgresql://deckdrive:replace-with-long-random-password@postgres:5432/deckdrive
PUBLIC_HOST=game.example.com
PUBLIC_BASE_URL=https://game.example.com
APP_BASE_URL=https://game.example.com
OAUTH_REDIRECT_BASE_URL=https://game.example.com
CORS_ORIGINS=https://game.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
BATTLE_COMMAND_SECRET=replace-with-long-random-secret
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
CARD_DATA_VERSION=1.0.0
