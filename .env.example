# Copy this file to .env and adjust values for local development.
# Do not commit .env or any file containing real secrets.

# PostgreSQL (infra/docker, docker-compose.yml)
POSTGRES_USER=deckdrive
POSTGRES_PASSWORD=deckdrive
POSTGRES_DB=deckdrive
# If you change POSTGRES_PORT, update the port in DATABASE_URL too; it is not derived automatically.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deckdrive:deckdrive@127.0.0.1:5432/deckdrive

# Mailpit (infra/docker, docker-compose.yml)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# Application baseline (values below are placeholders, not real secrets)
NODE_ENV=development
# Use at least 32 random characters in production. This value is never exposed
# to the browser and keeps OAuth state valid across API restarts/replicas.
SESSION_SECRET=replace-me
# Required to sign and verify protocol-2 battle server commands.
BATTLE_COMMAND_SECRET=
BATTLE_COMMAND_PREVIOUS_SECRETS=
PUBLIC_BASE_URL=http://localhost:3000

# Phase 5 API server. It binds to 127.0.0.1 by default. Development login is
# loopback-only even with a non-loopback HOST; use an authenticated reverse proxy
# for remote access and keep CORS_ORIGINS restricted to trusted web origins.
PORT=3000
# PvP matchmaking is process-local; deploy exactly one API process.
PVP_WORKER_COUNT=1
CORS_ORIGINS=http://localhost:5173
# 管理UIの開発サーバーは http://localhost:5174。APIはVite proxyで同一オリジンへ転送する。
# 開発時のURLはコード側に既定値があり、本番で別オリジンに配置する場合だけ指定する。
# VITE_WEB_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5174
# 本番で /admin/ 以外へ管理UIを配置する場合はビルド時に指定。
# VITE_ADMIN_BASE=/admin/
# 構造化ログをファイルでも保持して `pnpm logs` で閲覧する場合に設定。
# LOG_FILE=.deckdrive/api.log
# `pnpm health` の接続先（省略時 http://127.0.0.1:3000）。
# HEALTH_BASE_URL=http://127.0.0.1:3000
# Set only direct reverse-proxy IPs in deployment; this enables trusted
# X-Forwarded-For client addresses for OAuth rate limiting.
TRUSTED_PROXY_ADDRESSES=
# Current card-data snapshot selected for newly created decks.
CARD_DATA_VERSION=1.0.0

# OAuth (O00). Register each exact callback URL with its provider. Keep all
# client secrets in the deployment secret store; do not commit an .env file.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5173
# HTTP development: keep APP_BASE_URL, OAUTH_REDIRECT_BASE_URL and VITE_API_URL
# on the same hostname (do not mix localhost and 127.0.0.1); ports may differ.
# Production requires HTTPS: session cookies use Secure; SameSite=None for
# cross-site API fetches. Allow the exact app origin in CORS_ORIGINS. Browsers
# that block third-party cookies require a same-site API/reverse proxy.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
